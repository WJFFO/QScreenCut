      <!-- 同 Release：源码为 UTF-8 需要 /utf-8；Qt 6.11 需要 C++20，否则报 C2968 -->
      <AdditionalOptions>/utf-8 /std:c++20 %(AdditionalOptions)</AdditionalOptions>
      <!-- 同 Release：屏蔽 Qt 头文件触发的静态分析告警（26478/26495/26813） -->
      <DisableSpecificWarnings>26478;26495;26813;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <!-- 同 Release：屏蔽 Qt 6.10 的 compressEvent 弃用告警（C4996） -->
      <AdditionalIncludeDirectories>$(MSBuildProjectDirectory)\third_party\qwindowkit\$(Configuration)\include\QWindowKit;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- 同 Release：以静态库方式使用 QWindowKit -->
      <PreprocessorDefinitions>QT_WARN_DEPRECATED_UP_TO=0x060900;QWK_CORE_STATIC;QWK_WIDGETS_STATIC;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
