  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'" Label="Configuration">
    <ClCompile>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <!-- 源码以 UTF-8 保存，界面文字里有中文；不加 /utf-8 时 MSVC 会按本地代码页
           解析，中文字符串会变成乱码或直接报 C2001。
           /std:c++20 是实测要求：Qt 6.11 的 qcomparehelpers.h 在 C++17 下会让 MSVC
           报 C2968（递归的模板实例化），升到 C++20 才能正常编译 -->
      <AdditionalOptions>/utf-8 /std:c++20 %(AdditionalOptions)</AdditionalOptions>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <!-- 第三方（Qt）头文件产生的告警，不属于本项目代码问题：
           26495 / 26813 : MSVC 静态分析在 qcolor.h、qtransform.h 等 Qt 头文件内部命中
           26478 : qjsonobject.h 等 Qt 头文件内部对常量使用 std::move（ES.56）
           若不想屏蔽规则，可改为 <EnablePREfast>false</EnablePREfast> 关闭代码分析 -->
      <DisableSpecificWarnings>26478;26495;26813;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <!-- Qt 6.10 起 compressEvent 被标记 deprecated，qguiapplication.h / qapplication.h
           内部 override 时 MSVC 会报 C4996。限定只告警到 Qt 6.9，即可消除该噪音，
           同时保留自己代码中使用旧 API 的弃用提示。 -->
      <AdditionalIncludeDirectories>$(MSBuildProjectDirectory)\third_party\qwindowkit\$(Configuration)\include\QWindowKit;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- QWindowKit 以静态库方式链接，必须声明 QWK_CORE_STATIC / QWK_WIDGETS_STATIC，
           否则头文件会按动态库导入的方式声明符号，导致链接找不到实现 -->
      <PreprocessorDefinitions>QT_WARN_DEPRECATED_UP_TO=0x060900;QWK_CORE_STATIC;QWK_WIDGETS_STATIC;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>false</GenerateDebugInformation>
      <AdditionalLibraryDirectories>$(MSBuildProjectDirectory)\third_party\qwindowkit\$(Configuration)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <!-- windowsapp.lib 提供 WinRT 运行时入口（系统 API 兜底用） -->
      <AdditionalDependencies>QWKCore.lib;QWKWidgets.lib;windowsapp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'" Label="Configuration">
    <ClCompile>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
